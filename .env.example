# ─── API Backend Target ───────────────────────────────────────────────────────
# Django backend URL the app talks to (and the Vite dev proxy points at).
# Default: the deployed production backend (https).
VITE_API_TARGET=https://api.yemoda.site/api
# For local development, comment the line above and uncomment the one below:
# VITE_API_TARGET=http://127.0.0.1:8001

# ─── Google Auth ──────────────────────────────────────────────────────────────
# Optional. Overrides the URL used to start the Google OAuth flow.
# When unset, it defaults to `${VITE_API_TARGET}/auth/google/start/`.
VITE_GOOGLE_AUTH_START_URL=
